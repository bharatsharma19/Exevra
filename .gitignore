# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables and local configuration (never commit secrets)
.env
.env.*
config/*
!config/dev.example.json
!config/README.md

# Android signing material
android/key.properties
*.jks
*.keystore

# Gradle reports written outside /build/ and Supabase CLI scratch files
/android/build/
supabase/.temp/

# Signing certificates, provisioning profiles and Firebase configs
*.p8
*.p12
*.pem
*.mobileprovision
*.cer
*.der
AuthKey_*.p8
google-services.json
GoogleService-Info.plist
android/app/upload-keystore*
