# Edge Function secrets. Names only: never put real values in this file.
#
# Local:  copy to supabase/functions/.env (gitignored), fill in, then
#         supabase functions serve --env-file supabase/functions/.env
# Hosted: supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the platform.
# Do not set them here.

# ai-chat: at least one provider key is required. Claude is tried first, Gemini is the fallback.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (defaults: claude-haiku-5-5, gemini-3.8-flash).
CLAUDE_MODEL=
GEMINI_MODEL=
# Optional per-user limits (defaults: 50 per UTC day, 6 per minute).
AI_DAILY_QUOTA=
AI_PER_MINUTE=

# send-invite
RESEND_API_KEY=
# Verified sender, for example: Exevra <invites@your-domain>
INVITE_FROM_EMAIL=
# https base URL used for invitation links (no trailing slash).
APP_BASE_URL=

# delete-account: Sign in with Apple token revocation. Leave all four empty if Apple sign-in is
# not enabled; setting only some of them is a configuration error.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
# PKCS#8 PEM contents; newlines may be written as \n.
APPLE_PRIVATE_KEY=
